# Required: "Continue with Google" sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only Google accounts on this Workspace domain can sign in
ALLOWED_EMAIL_DOMAIN=contentjet.io
# Long random string that signs the session cookie, e.g. from `openssl rand -base64 32`
SESSION_SECRET=
# Only if the callback URL differs from https://<your-domain>/api/auth/callback
GOOGLE_REDIRECT_URI=

# Required: Monday.com API token the server reads the board with (must be able to see the Production board)
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=18409265319
MONDAY_API_VERSION=

# Optional: enables "Rewrite with Claude"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
