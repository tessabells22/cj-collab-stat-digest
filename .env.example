# Optional: "Sign in with Monday.com" (OAuth). Without these, people sign in by pasting a personal API token.
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
# Only if the callback URL differs from https://<your-domain>/api/auth/callback
MONDAY_REDIRECT_URI=

# Optional: only let people from this Monday.com account sign in (recommended)
ALLOWED_MONDAY_ACCOUNT_ID=

# Optional overrides
MONDAY_BOARD_ID=18409265319
MONDAY_API_VERSION=

# Optional: enables "Rewrite with Claude"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
